# URL da API consumida pela UI Admin.
#
# IMPORTANTE: o Vite injeta (baked) esta variavel no bundle em BUILD time, nao
# em runtime. Ou seja, o valor abaixo so vale para o `npm run dev`/build local.
#
# Em cluster/producao, este localhost NAO funciona dentro do pod. O valor precisa
# ser passado como build-arg na hora de construir a imagem, apontando para a URL
# da API acessivel pelo NAVEGADOR (ingress ou host do port-forward), por exemplo:
#
#   docker build --build-arg VITE_API_URL=http://localhost:3000 -t oficina-mecanica-web-admin:latest ./web/admin
#   # (via port-forward: kubectl port-forward -n oficina svc/oficina-app 3000:3000)
#   # com ingress: VITE_API_URL=https://api.suaoficina.com
#
# Trocar a env do pod depois do build NAO tem efeito.
VITE_API_URL=http://localhost:3000
